# ═══════════════════════════════════════════════════════════
# Trademun — Environment Variables
# فاز ۶: FastAPI Backend + Next.js Frontend
# ═══════════════════════════════════════════════════════════

# ─── App ───
# در production حتماً False باشد (لاگ OTP و /docs فقط در DEBUG فعال‌اند)
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ─── Database ───
# رمز دیتابیس Postgres (docker-compose از این مقدار استفاده می‌کند و باید با DATABASE_URL یکی باشد)
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://trademun:<POSTGRES_PASSWORD>@postgres:5432/trademun
# DATABASE_URL=sqlite:///./data/trademun.db
# DATABASE_URL=postgresql://user:pass@host/db

# ─── CORS ───
# CORS_ORIGINS=["http://localhost:3000"]

# ─── Scheduler ───
SCHEDULER_ENABLED=True
BACKTEST_INTERVAL_MINUTES=30

# ─── Nobitex (فاز ۷) ───
NOBITEX_API_KEY=
NOBITEX_SECRET_KEY=

# ─── Admin API Key (باگ ۴) ───
# عملیات مخرب مثل DELETE /backtest/reset با هدر X-API-Key محافظت می‌شود.
# با `openssl rand -hex 32` بساز. خالی بگذاری = عملیات admin کاملاً مسدود.
ADMIN_API_KEY=

# ─── Telegram (فاز ۷) ───
TELEGRAM_BOT_TOKEN=

# ─── JWT (فاز ۷) ───
# حداقل ۳۲ کاراکتر — با `openssl rand -hex 32` بساز. مقدار پیش‌فرض باعث توقف برنامه می‌شود (وقتی DEBUG=False)
JWT_SECRET=

# ─── ادمین‌ها (شماره‌ها با کاما جدا شوند) ───
ADMIN_PHONES=

ZIBAL_MERCHANT=your_zibal_merchant_code