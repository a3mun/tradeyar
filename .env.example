# ═══════════════════════════════════════════════════════════
# Trademun — Environment Variables
# فاز ۶: FastAPI Backend + Next.js Frontend
# ═══════════════════════════════════════════════════════════

# ─── App ───
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ─── Database ───
# DATABASE_URL=sqlite:///./data/trademun.db
# DATABASE_URL=postgresql://user:pass@host/db

# ─── CORS ───
# CORS_ORIGINS=["http://localhost:3000"]

# ─── Scheduler ───
SCHEDULER_ENABLED=True
BACKTEST_INTERVAL_MINUTES=30

# ─── Nobitex (فاز ۷) ───
NOBITEX_API_KEY=
NOBITEX_SECRET_KEY=

# ─── Admin API Key (باگ ۴) ───
# عملیات مخرب مثل DELETE /backtest/reset با هدر X-API-Key محافظت می‌شود.
# با `openssl rand -hex 32` بساز. خالی بگذاری = عملیات admin کاملاً مسدود.
ADMIN_API_KEY=

# ─── Telegram (فاز ۷) ───
TELEGRAM_BOT_TOKEN=

# ─── JWT (فاز ۷) ───
JWT_SECRET=change-me-in-production
