# ═══════════════════════════════════════════════════════════
# Trademun — .gitignore
# ═══════════════════════════════════════════════════════════

# ═══ Python ═══
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ═══ Virtual environments ═══
.venv/
venv/
ENV/
env/
.python-version

# ═══ تست و کیفیت کد ═══
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ═══ Environment / Secrets ═══
.env
.env.local
.env*.local
*api-keys*
api-keys*.txt
secrets/
*.key
*.pem
*.p12
*.pfx

# ═══ Database ═══
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
*.sqlite
*.sqlite3

# ═══ State محلی (منسوخ — با مهاجرت به دیتابیس) ═══
data/signals_log.json
data/user_prefs.json
data/custom_symbols.json

# ═══ Node / Next.js ═══
node_modules/
.pnp
.pnp.js
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ═══ Node debug ═══
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ═══ Streamlit (منسوخ — رابط حذف شد) ═══
.streamlit/

# ═══ Editor ═══
.vscode/
.idea/
*.swp
*.swo

# ═══ OS ═══
.DS_Store
Thumbs.db
desktop.ini
