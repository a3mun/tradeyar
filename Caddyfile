api.trademun.ir {
    # 🔴 WebSocket (باید قبل از reverse_proxy عمومی باشه)
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websocket api:7860

    # بقیه درخواست‌ها (HTTP معمولی)
    reverse_proxy api:7860
    encode gzip
    log {
        output file /data/api-access.log
    }
}

trademun.ir {
    reverse_proxy frontend:3000
    encode gzip
    log {
        output file /data/frontend-access.log
    }

 # ⬅️ این بلاک رو برای تایید اینماد اضافه کن
    handle /32191391.txt {
        root * /srv/frontend/public
        file_server
    }

}


www.trademun.ir {
    redir https://trademun.ir{uri}
}